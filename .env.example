# Reelify environment variables (CLAUDE.md section 12). Copy to .env and fill in. Never commit .env.
# In local dev, `shopify app dev` injects SHOPIFY_API_KEY, SHOPIFY_API_SECRET, SHOPIFY_APP_URL and SCOPES.

# Shopify
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_products

# Database (Neon PostgreSQL)
# Pooled connection (host contains "-pooler") — app runtime
DATABASE_URL=
# Direct connection — Prisma migrations and pg-boss
DIRECT_URL=
# Separate Neon branch ("test") — automated tests only. Must NOT be the same database as above.
DATABASE_URL_TEST=
# Optional: direct (unpooled) URL of the same test branch, used by `npm run test:db:migrate`.
DIRECT_URL_TEST=

# Cloudflare Stream (D10) — see docs/STREAM.md §3. Non-production account for dev/staging; separate production account (D12).
# Account id (32 hex chars)
CLOUDFLARE_ACCOUNT_ID=
# API token with Account › Stream › Edit, this account only (secret)
CLOUDFLARE_STREAM_API_TOKEN=
# The <CODE> in customer-<CODE>.cloudflarestream.com
CLOUDFLARE_STREAM_CUSTOMER_CODE=
# Signing key for private playback — created once by: npm run stream:signing-key -- --write-env (JWK is secret)
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_KEY_JWK=
# Webhook secret returned when registering the webhook URL (Day 4; secret)
CLOUDFLARE_STREAM_WEBHOOK_SECRET=

# Secrets — ENCRYPTION_KEY must be 64 hex chars (32 bytes); ENCRYPTION_KEY_VERSION a positive integer.
# After rotating, keep the old key as ENCRYPTION_KEY_V<old version>=... so existing ciphertexts still decrypt.
# (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=
OAUTH_STATE_SECRET=

# Instagram (feature-flagged, default off)
FEATURE_INSTAGRAM=false
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=

# Monitoring / runtime
SENTRY_DSN=
NODE_ENV=

# Optional, read by the template's app/shopify.server.js (not in CLAUDE.md section 12)
SHOP_CUSTOM_DOMAIN=
